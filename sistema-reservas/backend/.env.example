# Para Prisma CLI en tu máquina local
# DATABASE_URL_HOST="postgresql://reservas_user:ReservasDevPass_2025@localhost:5433/reservas_db"

# Usamos esta URL para que Prisma funcione en local (VS Code, migraciones)
# Docker usará la variable de entorno definida en docker-compose.yml
DATABASE_URL="postgresql://reservas_user:ReservasDevPass_2025@localhost:5433/reservas_db"

#--- Para que los contenedores se comuniquen entre sí ---
# Para el backend dentro de Docker (comentado porque se define en docker-compose)
# DATABASE_URL="postgresql://reservas_user:ReservasDevPass_2025@db:5432/reservas_db"
REDIS_URL="redis://redis:6379"

# Puerto en el que corre la aplicación DENTRO del contenedor
PORT=3001

# WhatsApp Bot Configuration
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=./src/whatsapp/sessions

# CLAVES PARA JWT (las tuyas están perfectas)
JWT_SECRET="clavehipermegasupercuadruplesecretasecretisima"
JWT_EXPIRES_IN="1d"

.env
# Credenciales para que el script de inicio (entrypoint) se conecte a la BD
POSTGRES_USER=reservas_user
POSTGRES_PASSWORD=ReservasDevPass_2025
POSTGRES_DB=reservas_db