{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend para el sistema de reservas del Hotel Don Teo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "dotenv -e .env.development -- nodemon src/server.js",
    "test": "dotenv -e .env.test -- vitest",
    "coverage": "dotenv -e .env.test -- vitest run --coverage",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:dev": "dotenv -e .env.development -- npx prisma",
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@whiskeysockets/baileys": "6.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "pino": "9.4.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "supertest": "^7.0.0"
  }
}
