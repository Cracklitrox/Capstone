{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend para el sistema de reservas del Hotel Don Teo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "dotenv -e .env.development -- nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:dev": "dotenv -e .env.development -- npx prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "redis": "^5.8.2",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.15.0",
    "supertest": "^7.0.0"
  }
}