      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{reservationId}}/history",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "{{reservationId}}", "history"]
        }
      }
