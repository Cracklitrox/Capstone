        },
        "url": {
          "raw": "{{baseUrl}}/reservations/{{reservationId}}/check-out",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "{{reservationId}}", "check-out"]
        }
      }
    },
    {
      "name": "13. Ver Historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Historial contiene cambios de pago mixto\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.history).to.be.an('array');",
              "    pm.expect(jsonData.history.length).to.be.greaterThan(0);",
              "    ",
              "    console.log('Total de cambios registrados:', jsonData.history.length);",
              "});"
            ],
            "type": "text/javascript"
