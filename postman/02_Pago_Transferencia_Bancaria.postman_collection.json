            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newStatus\": \"ready_for_checkin\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservations/{{reservationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "{{reservationId}}", "status"]
        }
      }
    },
    {
      "name": "10. Check-in",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"✅ Check-in realizado, status = 'in_progress'\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.reservation.status).to.equal('in_progress');",
              "});"
            ],
