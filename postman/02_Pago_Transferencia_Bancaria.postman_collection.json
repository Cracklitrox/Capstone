    {
      "name": "13. Ver Historial",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"✅ Historial tiene múltiples cambios\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.history).to.be.an('array');",
              "    pm.expect(jsonData.history.length).to.be.greaterThan(4);",
