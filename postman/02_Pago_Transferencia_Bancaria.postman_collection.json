              "pm.test(\"✅ Check-out realizado, status = 'completed'\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.reservation.status).to.equal('completed');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
