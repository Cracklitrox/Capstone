      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identificationNumber\": \"20789012-3\",\n  \"firstName\": \"Validation\",\n  \"paternalLastName\": \"Test\",\n  \"maternalLastName\": \"User\",\n  \"email\": \"validation.test@test.com\",\n  \"phoneNumber\": \"+56912345099\",\n  \"birthDate\": \"1990-01-01\",\n  \"gender\": \"other\",\n  \"password\": \"Test1234!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/guests",
          "host": ["{{baseUrl}}"],
          "path": ["guests"]
        }
      }
    },
    {
      "name": "0. Setup - Buscar Habitación",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Habitación encontrada\", function () {",
              "    pm.response.to.have.status(200);",
              "    const jsonData = pm.response.json();",
              "    pm.environment.set(\"roomId1\", jsonData.availableRooms[0].id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {
          "raw": "{{baseUrl}}/reservations/search-availability?checkInDate=2025-12-01T15:00:00.000Z&checkOutDate=2025-12-02T11:00:00.000Z&guests=1",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "search-availability"],
          "query": [
            {"key": "checkInDate", "value": "2025-12-01T15:00:00.000Z"},
            {"key": "checkOutDate", "value": "2025-12-02T11:00:00.000Z"},
            {"key": "guests", "value": "1"}
          ]
        }
      }
    },
    {
      "name": "ERROR 1: Reserva 1 día con paymentType 'daily'",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"✅ ERROR 400 - Reserva 1 día debe ser 'full'\", function () {",
              "    pm.response.to.have.status(400);",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include('1 día');",
              "    pm.expect(jsonData.message).to.include('full');",
              "    console.log('Error correcto:', jsonData.message);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mainGuestId\": {{guestId}},\n  \"roomIds\": [{{roomId1}}],\n  \"checkInDate\": \"2025-12-01T15:00:00.000Z\",\n  \"checkOutDate\": \"2025-12-02T11:00:00.000Z\",\n  \"guestCount\": 1,\n  \"channel\": \"reception\",\n  \"paymentMethod\": \"cash\",\n  \"paymentAmount\": 35000,\n  \"paymentType\": \"daily\",\n  \"roomGuestAssignments\": [\n    {\n      \"roomId\": {{roomId1}},\n      \"guestIds\": [{{guestId}}]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": ["{{baseUrl}}"],
          "path": ["reservations"]
        }
      }
    },
